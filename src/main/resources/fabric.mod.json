{
	"schemaVersion": 1,
	"id": "nemos_campfires",
	"version": "${version}",
	"name": "Nemo's Campfires",
	"description": "Add more campfires to Minecraft!",
	"authors": [
		"Nemo"
	],
	"contact": {
